<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: #080808;
  color: #fff;
  font-family: 'Barlow', sans-serif;
  overflow-x: hidden;
}

/* ── GLASS SYSTEM ── */
.glass {
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.08);
  position: relative;
}
.glass::before {
  content: "";
  position: absolute; inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(160deg,
    rgba(255,255,255,0.22) 0%,
    rgba(255,255,255,0.06) 30%,
    rgba(255,255,255,0) 60%,
    rgba(255,255,255,0.10) 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.glass-strong {
  background: rgba(255,255,255,0.07);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  border: 1px solid rgba(255,255,255,0.12);
  position: relative;
}
.glass-strong::before {
  content: "";
  position: absolute; inset: 0;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(160deg,
    rgba(255,255,255,0.35) 0%,
    rgba(255,255,255,0.08) 40%,
    rgba(255,255,255,0) 60%,
    rgba(255,255,255,0.15) 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

/* ── NOISE TEXTURE OVERLAY ── */
body::before {
  content: "";
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  background-size: 200px;
  pointer-events: none;
  z-index: 999;
  opacity: 0.4;
}

/* ── ORBS ── */
.orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  z-index: 0;
}
.orb-1 { width: 600px; height: 600px; top: -200px; left: -150px; background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%); }
.orb-2 { width: 500px; height: 500px; bottom: 10%; right: -100px; background: radial-gradient(circle, rgba(200,200,200,0.05) 0%, transparent 70%); }
.orb-3 { width: 400px; height: 400px; top: 40%; left: 40%; background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, transparent 70%); }

/* ── LAYOUT ── */
.page-wrap { position: relative; z-index: 1; }

/* ── NAV ── */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 1rem 3rem;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-inner {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%;
}
.nav-logo {
  font-family: 'Instrument Serif', serif;
  font-style: italic;
  font-size: 1.5rem;
  color: #fff;
  letter-spacing: -0.03em;
}
.nav-logo span { color: rgba(255,255,255,0.4); font-size: 0.75rem; font-style: normal; font-family: 'Barlow', sans-serif; font-weight: 300; display: block; letter-spacing: 0.15em; text-transform: uppercase; margin-top: -2px; }
.nav-links { display: flex; align-items: center; gap: 2rem; }
.nav-links a { font-size: 0.8rem; font-weight: 400; color: rgba(255,255,255,0.6); text-decoration: none; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.3s; }
.nav-links a:hover { color: #fff; }
.nav-cta {
  background: #fff; color: #000;
  border: none; border-radius: 9999px;
  padding: 0.5rem 1.25rem;
  font-family: 'Barlow', sans-serif;
  font-size: 0.8rem; font-weight: 500;
  cursor: pointer; letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: opacity 0.2s;
}
.nav-cta:hover { opacity: 0.85; }

/* ── HERO ── */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center;
  padding: 7rem 2rem 4rem;
  position: relative;
}
.hero-tag {
  display: inline-flex; align-items: center; gap: 0.5rem;
  border-radius: 9999px; padding: 0.35rem 1rem;
  font-size: 0.72rem; font-weight: 500;
  color: rgba(255,255,255,0.7);
  letter-spacing: 0.12em; text-transform: uppercase;
  margin-bottom: 2rem;
}
.hero-tag .dot { width: 6px; height: 6px; background: #fff; border-radius: 50%; animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.8)} }

.hero-name {
  font-family: 'Instrument Serif', serif;
  font-style: italic;
  font-size: clamp(4rem, 12vw, 9rem);
  line-height: 0.88;
  letter-spacing: -0.04em;
  color: #fff;
  margin-bottom: 1.5rem;
}
.hero-name .dim { color: rgba(255,255,255,0.25); }

.hero-sub {
  max-width: 36rem;
  font-size: 0.95rem;
  font-weight: 300;
  color: rgba(255,255,255,0.55);
  line-height: 1.7;
  margin-bottom: 2.5rem;
}

.hero-ctas { display: flex; align-items: center; gap: 1rem; justify-content: center; margin-bottom: 4rem; }
.btn-primary {
  border-radius: 9999px; padding: 0.75rem 1.75rem;
  font-family: 'Barlow', sans-serif; font-size: 0.875rem; font-weight: 500;
  color: #fff; border: none; cursor: pointer;
  display: flex; align-items: center; gap: 0.5rem;
  letter-spacing: 0.03em;
}
.btn-outline {
  border-radius: 9999px; padding: 0.75rem 1.75rem;
  font-family: 'Barlow', sans-serif; font-size: 0.875rem; font-weight: 400;
  color: rgba(255,255,255,0.7); background: transparent;
  border: 1px solid rgba(255,255,255,0.15); cursor: pointer;
  letter-spacing: 0.03em; transition: border-color 0.3s, color 0.3s;
}
.btn-outline:hover { border-color: rgba(255,255,255,0.4); color: #fff; }

/* Stats row */
.hero-stats {
  display: flex; align-items: stretch; gap: 1px;
  border-radius: 1.25rem; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08);
}
.stat-item {
  padding: 1.25rem 2rem;
  text-align: center;
  background: rgba(255,255,255,0.03);
  backdrop-filter: blur(20px);
  flex: 1;
}
.stat-item + .stat-item { border-left: 1px solid rgba(255,255,255,0.06); }
.stat-num {
  font-family: 'Instrument Serif', serif;
  font-style: italic;
  font-size: 2rem;
  color: #fff;
  line-height: 1;
  letter-spacing: -0.02em;
}
.stat-label { font-size: 0.7rem; color: rgba(255,255,255,0.4); font-weight: 300; margin-top: 0.4rem; letter-spacing: 0.08em; text-transform: uppercase; }

/* scroll indicator */
.scroll-hint {
  position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
  display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  color: rgba(255,255,255,0.25); font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase;
}
.scroll-line { width: 1px; height: 40px; background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent); animation: scrollDrop 2s ease-in-out infinite; }
@keyframes scrollDrop { 0%{transform:scaleY(0);transform-origin:top} 50%{transform:scaleY(1);transform-origin:top} 51%{transform:scaleY(1);transform-origin:bottom} 100%{transform:scaleY(0);transform-origin:bottom} }

/* ── SECTION BASE ── */
section { padding: 6rem 3rem; position: relative; }
.section-label {
  font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: rgba(255,255,255,0.35); font-weight: 400;
  margin-bottom: 1rem;
}
.section-title {
  font-family: 'Instrument Serif', serif;
  font-style: italic;
  font-size: clamp(2.5rem, 6vw, 5rem);
  line-height: 0.92;
  letter-spacing: -0.03em;
  color: #fff;
  margin-bottom: 3rem;
}

/* ── ABOUT ── */
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; max-width: 1100px; margin: 0 auto; }
.about-text { font-size: 1rem; font-weight: 300; color: rgba(255,255,255,0.6); line-height: 1.8; }
.about-text strong { color: #fff; font-weight: 500; }
.about-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
.tag { border-radius: 9999px; padding: 0.35rem 0.9rem; font-size: 0.72rem; font-weight: 400; color: rgba(255,255,255,0.7); letter-spacing: 0.06em; }

.about-card { border-radius: 1.5rem; padding: 2rem; }
.about-card-label { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 0.75rem; }
.about-card-val { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 1.75rem; color: #fff; letter-spacing: -0.02em; }
.about-card + .about-card { margin-top: 1rem; }

/* ── SKILLS ── */
.skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; max-width: 1100px; margin: 0 auto; }
.skill-card {
  border-radius: 1.25rem;
  padding: 1.5rem;
  display: flex; flex-direction: column; gap: 1rem;
  transition: transform 0.3s, background 0.3s;
  cursor: default;
}
.skill-card:hover { transform: translateY(-4px); background: rgba(255,255,255,0.08); }
.skill-icon-wrap {
  width: 44px; height: 44px; border-radius: 0.75rem;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.4rem;
}
.skill-name { font-size: 1rem; font-weight: 500; color: #fff; }
.skill-desc { font-size: 0.78rem; font-weight: 300; color: rgba(255,255,255,0.45); line-height: 1.5; }
.skill-bar-wrap { height: 2px; background: rgba(255,255,255,0.08); border-radius: 9999px; overflow: hidden; margin-top: auto; }
.skill-bar { height: 100%; background: linear-gradient(90deg, rgba(255,255,255,0.8), rgba(255,255,255,0.3)); border-radius: 9999px; transition: width 1.2s cubic-bezier(0.16,1,0.3,1); width: 0; }
.skill-level { font-size: 0.65rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); text-transform: uppercase; margin-top: 0.4rem; }

/* ── SERVICES ── */
.services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border-radius: 1.5rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.06); max-width: 1100px; margin: 0 auto; }
.service-item {
  padding: 2rem;
  background: rgba(255,255,255,0.02);
  backdrop-filter: blur(10px);
  transition: background 0.3s;
}
.service-item:hover { background: rgba(255,255,255,0.06); }
.service-num { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 0.9rem; color: rgba(255,255,255,0.2); margin-bottom: 1rem; }
.service-title { font-size: 1.1rem; font-weight: 500; color: #fff; margin-bottom: 0.75rem; }
.service-desc { font-size: 0.8rem; font-weight: 300; color: rgba(255,255,255,0.45); line-height: 1.6; }

/* ── WORKS ── */
.works-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 1100px; margin: 0 auto; }
.work-card {
  border-radius: 1.25rem;
  overflow: hidden;
  aspect-ratio: 4/5;
  position: relative;
  cursor: pointer;
  transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
}
.work-card:first-child { grid-column: span 2; aspect-ratio: 16/9; }
.work-card:hover { transform: scale(0.98); }
.work-bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center;
  transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
}
.work-card:hover .work-bg { transform: scale(1.05); }
.work-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);
  display: flex; flex-direction: column; justify-content: flex-end;
  padding: 1.5rem;
}
.work-cat { font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 0.4rem; }
.work-title { font-family: 'Instrument Serif', serif; font-style: italic; font-size: 1.5rem; color: #fff; letter-spacing: -0.02em; }
.work-arrow {
  position: absolute; top: 1rem; right: 1rem;
  width: 36px; height: 36px; border-radius: 9999px;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transition: opacity 0.3s;
}
.work-card:hover .work-arrow { opacity: 1; }

/* ── CONTACT ── */
.contact-wrap { max-width: 700px; margin: 0 auto; text-align: center; }
.contact-email {
  font-family: 'Instrument Serif', serif;
  font-style: italic;
  font-size: clamp(1.5rem, 4vw, 3rem);
  color: #fff;
  text-decoration: none;
  letter-spacing: -0.02em;
  display: inline-block;
  margin: 1.5rem 0 2.5rem;
  opacity: 0.85;
  transition: opacity 0.3s;
}
.contact-email:hover { opacity: 1; }
.social-row { display: flex; align-items: center; justify-content: center; gap: 1rem; }
.social-btn { border-radius: 9999px; padding: 0.5rem 1.25rem; font-size: 0.78rem; color: rgba(255,255,255,0.6); text-decoration: none; letter-spacing: 0.05em; transition: color 0.3s, border-color 0.3s; }
.social-btn:hover { color: #fff; border-color: rgba(255,255,255,0.3) !important; }

/* ── FOOTER ── */
footer {
  padding: 2rem 3rem;
  border-top: 1px solid rgba(255,255,255,0.06);
  display: flex; align-items: center; justify-content: space-between;
}
footer p { font-size: 0.72rem; color: rgba(255,255,255,0.25); font-weight: 300; letter-spacing: 0.05em; }

/* ── ANIMATIONS ── */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1);
}
.reveal.visible { opacity: 1; transform: translateY(0); }
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }
.reveal-delay-4 { transition-delay: 0.4s; }

/* ── DIVIDER ── */
.divider { border: none; border-top: 1px solid rgba(255,255,255,0.05); margin: 0; }

/* ── MOBILE ── */
@media (max-width: 768px) {
  nav { padding: 1rem 1.5rem; }
  .nav-links { display: none; }
  section { padding: 4rem 1.5rem; }
  .about-grid { grid-template-columns: 1fr; }
  .services-grid { grid-template-columns: 1fr; }
  .works-grid { grid-template-columns: 1fr; }
  .work-card:first-child { grid-column: span 1; aspect-ratio: 4/3; }
  footer { flex-direction: column; gap: 1rem; text-align: center; }
}
</style>
</head>
